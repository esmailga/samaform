# Served from the site root (the build copies this file into dist/).

# --- Never serve the database or other private files ----------------------------------
# database.db holds every client's details; it must not be downloadable. (.DS_Store: macOS folder listings)
<FilesMatch "(\.(db|sqlite|sqlite3|env|log|md)|^\.DS_Store)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- One address per page: https://www.samaform.com ---------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.samaform.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^samaform\.com$ [NC]
  RewriteRule ^ https://www.samaform.com%{REQUEST_URI} [L,R=301]

  # --- Pages ----------------------------------------------------------------------------
  RewriteRule ^index\.html$ - [L]

  # The English home page is /en/ (send /en there directly instead of via an http redirect)
  RewriteRule ^en$ https://www.samaform.com/en/ [L,R=301]

  # Each page has its own HTML file with its title and description (services.html, en/services.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]

  # Everything else is handled by the app
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# --- Keep the admin area, the API and clients' uploaded photos out of search results ------
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/(adviechadowsecupor|api/|uploads/)" NOINDEX_PATH
</IfModule>
<IfModule mod_headers.c>
  # REDIRECT_ variant: the variable is renamed after the internal rewrite to index.html / index.php
  Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX_PATH
  Header set X-Robots-Tag "noindex, nofollow" env=REDIRECT_NOINDEX_PATH
</IfModule>

# --- Speed --------------------------------------------------------------------------------
<IfModule mod_setenvif.c>
  # Files in /assets/ have a content hash in their name, so they can be cached for a year
  SetEnvIf Request_URI "^/assets/" HASHED_ASSET
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml font/ttf
</IfModule>
