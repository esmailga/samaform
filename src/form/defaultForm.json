          "required": true,
          "multiple": false,
          "layout": "row",
          "options": [
            {
              "id": "1",
              "label": {
                "ar": "١ - ٢",
                "en": "1 - 2"
              }
            },
            {
              "id": "2",
              "label": {
                "ar": "٣ - ٤",
                "en": "3 - 4"
              }
            },
            {
              "id": "3",
              "label": {
                "ar": "٥+",
                "en": "5+"
              }
            }
          ],
          "showIf": {
            "field": "projectType",
            "values": [
              "apartement"
            ]
          },
          "exact": {
            "id": "roomCountExact",
            "placeholder": {
              "ar": "أو أدخل العدد الدقيق للغرف...",
              "en": "Or enter exact number of rooms..."
