{
  "steps": [
    {
      "id": "basic",
      "title": {
        "ar": "المعلومات الأساسية",
        "en": "Basic Information"
      },
      "heading": {
        "ar": "أخبرنا عن نفسك",
        "en": "Tell us about yourself"
      },
      "fields": [
        {
          "id": "name",
          "type": "text",
          "label": {
            "ar": "الاسم الكامل",
            "en": "Full Name"
          },
          "placeholder": {
            "ar": "أدخل اسمك الكامل",
            "en": "Enter your full name"
          },
          "required": true,
          "validation": "fullName"
        },
        {
          "id": "email",
          "type": "email",
          "label": {
            "ar": "البريد الإلكتروني",
            "en": "Email"
          },
          "placeholder": {
            "ar": "أدخل بريدك الإلكتروني",
            "en": "Enter your email"
          },
          "required": false
        },
        {
          "id": "phone",
          "type": "phone",
          "label": {
            "ar": "رقم الهاتف",
            "en": "Phone Number"
          },
          "placeholder": {
            "ar": "أدخل رقم هاتفك",
            "en": "Enter your phone number"
          },
          "required": true
        },
        {
          "id": "city",
          "type": "text",
          "label": {
            "ar": "المدينة",
            "en": "City"
          },
          "placeholder": {
            "ar": "أدخل مدينتك",
            "en": "Enter your city"
          },
          "required": true,
          "validation": "minLength3"
        }
      ]
    },
    {
      "id": "projectType",
      "title": {
        "ar": "نوع المشروع",
        "en": "Project Type"
      },
      "heading": {
        "ar": "اختار نوع المساحة التي تريد تصميمها",
        "en": "What kind of space are you planning?"
      },
      "fields": [
        {
          "id": "projectType",
          "type": "cards",
          "label": {
            "ar": "نوع المشروع",
            "en": "Project Type"
          },
          "required": true,
          "options": [
            {
              "id": "apartement",
              "icon": "Home",
              "label": {
                "ar": "شقق سكنية",
                "en": "Residential apartments"
              },
              "description": {
                "ar": "مساحات معيشة حديثة",
                "en": "Modern living spaces"
              }
            },
            {
              "id": "villa",
              "icon": "Building",
              "label": {
                "ar": "فلل، منازل خاصة",
                "en": "Luxury residences"
              },
              "description": {
                "ar": "المساكن الفاخرة",
                "en": "Exclusive private residences"
              }
            },
            {
              "id": "shop",
              "icon": "ShoppingBag",
              "label": {
                "ar": "مساحات تجارية",
                "en": "Retail spaces"
              },
              "description": {
                "ar": "محلات تجارية",
                "en": "Commercial retail outlets"
              }
            },
            {
              "id": "restaurant",
              "icon": "Utensils",
              "label": {
                "ar": "مطعم / كافيه",
                "en": "Restaurant / Café"
              },
              "description": {
                "ar": "مساحات طعام ومقاهي",
                "en": "Cafés and dining spaces"
              }
            },
            {
              "id": "office",
              "icon": "Briefcase",
              "label": {
                "ar": "مكاتب / شركة",
                "en": "Offices"
              },
              "description": {
                "ar": "بيئات عمل احترافية",
                "en": "Professional work environments"
              }
            },
            {
              "id": "beautySalon",
              "icon": "Sparkles",
              "label": {
                "ar": "صالون تجميل",
                "en": "Beauty-Wellness Salon"
              },
              "description": {
                "ar": "مراكز العناية والتجميل",
                "en": "Wellness and beauty centers"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "details",
      "title": {
        "ar": "تفاصيل المشروع",
        "en": "Project Details"
      },
      "heading": {
        "ar": "أخبرنا المزيد عن رؤيتك",
        "en": "Tell us more about your vision"
      },
      "fields": [
        {
          "id": "budgetTier",
          "type": "choice",
          "label": {
            "ar": "الميزانية",
            "en": "Budget"
          },
          "required": false,
          "multiple": false,
          "layout": "grid2",
          "options": [
            {
              "id": "economy",
              "label": {
                "ar": "اقتصادي",
                "en": "Economy"
              }
            },
            {
              "id": "standard",
              "label": {
                "ar": "قياسي",
                "en": "Standard"
              }
            },
            {
              "id": "premium",
              "label": {
                "ar": "متميز",
                "en": "Premium"
              }
            },
            {
              "id": "luxury",
              "label": {
                "ar": "فاخر",
                "en": "Luxury"
              }
            }
          ],
          "exact": {
            "id": "budgetExact",
            "placeholder": {
              "ar": "أو أدخل الميزانية بالضبط بالدولار الأمريكي",
              "en": "Or enter exact budget in USD"
            },
            "max": 999999,
            "prefix": "$"
          }
        },
        {
          "id": "areaTier",
          "type": "choice",
          "label": {
            "ar": "مساحة المشروع (متر مربع)",
            "en": "Project Area (sqm)"
          },
          "required": false,
          "multiple": false,
          "layout": "grid4",
          "options": [
            {
              "id": "small",
              "label": {
                "ar": "صغير (< ١٠٠ م٢)",
                "en": "Small (< 100 sqm)"
              }
            },
            {
              "id": "medium",
              "label": {
                "ar": "متوسط (١٠٠ - ٣٠٠ م٢)",
                "en": "Medium (100 - 300 sqm)"
              }
            },
            {
              "id": "large",
              "label": {
                "ar": "كبير (٣٠٠ - ٥٠٠ م٢)",
                "en": "Large (300 - 500 sqm)"
              }
            },
            {
              "id": "veryLarge",
              "label": {
                "ar": "كبير جداً (> ٥٠٠ م٢)",
                "en": "Very Large (> 500 sqm)"
              }
            }
          ],
          "exact": {
            "id": "areaExact",
            "placeholder": {
              "ar": "أو أدخل المساحة بالضبط",
              "en": "Or enter exact area in sqm"
            },
            "max": 9999,
            "suffix": " sqm"
          }
        },
        {
          "id": "timeline",
          "type": "choice",
          "label": {
            "ar": "الجدول الزمني",
            "en": "Desired Timeline"
          },
          "required": true,
          "multiple": false,
          "layout": "grid4",
          "options": [
            {
              "id": "urgent",
              "label": {
                "ar": "عاجل (أقل من شهر)",
                "en": "Urgent (< 1 month)"
              }
            },
            {
              "id": "normal",
              "label": {
                "ar": "عادي (١- ٣ أشهر)",
                "en": "Normal (1 - 3 months)"
              }
            },
            {
              "id": "relaxed",
              "label": {
                "ar": "مريح (٣ - ٦ أشهر)",
                "en": "Relaxed (3 - 6 months)"
              }
            },
            {
              "id": "flexible",
              "label": {
                "ar": "مرن",
                "en": "Flexible"
              }
            }
          ]
        },
        {
          "id": "projectDetails",
          "type": "textarea",
          "label": {
            "ar": "تفاصيل المشروع",
            "en": "Project Details"
          },
          "placeholder": {
            "ar": "أخبرنا المزيد عن رؤيتك، المتطلبات الخاصة، أو أي قيود",
            "en": "Tell us more about your vision, specific requirements, or any constraints"
          },
          "required": false
        }
      ]
    },
    {
      "id": "specifics",
      "title": {
        "ar": "تفاصيل محددة",
